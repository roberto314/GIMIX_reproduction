                      00001         * GMXBG32
                      00002         
                      00003         * GMXBUG interrupt handlers and DAT initialization for
                      00004         * CPU-III board with vector for UAM and WPR trapping
                      00005         
                      00006         * version to set up DAT for switching system
                      00007         * also includes patch for new monitor switching circuit
                      00008         * and new header string
                      00009         
     DFC2             00010         SW3VEC  EQU    $DFC2
     DFC4             00011         SW2VEC  EQU    $DFC4            soft interrupt vectors   
     DFC6             00012         FIRVEC  EQU    $DFC6
     DFC8             00013         IRQVEC  EQU    $DFC8
     DFCA             00014         SWIVEC  EQU    $DFCA
     E40A             00015         NMIVEC  EQU    $E40A            
     E460             00016         TRPVEC  EQU    $E460            vector for UAM/WPR/WDT/SST trap 
     E280             00017         TSR     EQU    $E280            task select/control register
     F800             00018         DATRAM  EQU    $F800            start of DAT memory
                      00019         *COLD    EQU    $F82E            GMXBUG cold start
     F5ED             00020         OS9ADD  EQU    $F5ED
