                      00280         
                      00281         *Output registers
                      00282         *This routine outputs the current contents
                      00283         *of the machine registers. The PC value is the
                      00284         *return address left by the call to this routine.
                      00285         
F923 347F             00286         PRTREG  PSHS   #$7F              push all but PC
F925 1F43             00287                 TFR    S,U               copy stack pointer
F927 8D04             00288                 BSR    PRTR1             call output routine
F929 35FF             00289                 PULS   #$FF              exit by pulling all regs
                      00290         
