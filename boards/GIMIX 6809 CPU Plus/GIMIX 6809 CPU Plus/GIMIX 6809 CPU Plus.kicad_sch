	)
	(text "Replacement Options for the FPLA:\nAT27C512R (45ns read time). Different\npinout and one-time programmable though.\nAT29C512 (70ns) Flash Memory.\nW27C512-45 (45ns) EEPROM.\nOr maybe a GAL22V10 without \nthe DIP Switch Read."
		(exclude_from_sim no)
		(at 204.216 97.536 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "33d9daf6-4619-42b9-affd-40504b3003c4")
	)
	(text "SW1: Enable on-board option"
		(exclude_from_sim no)
		(at 211.836 57.15 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "3add9723-20f4-47d7-acc3-0040bcaa0004")
	)
	(text "check all chips.\nThey are mostly guesswork except:\nU21, U22, U23, U37, U39, U40, U43, U44, U45.\nU8, U9, U1, U2, U3.\nThey are mentioned in the documentation.\nThe following ICs are written on the schematic:\nU38, U41, U42,\nThe following ICs are clear too:\nEPROMS U4-U7,\nCPU: U47,\nFPLA: U36,\n\nCheck especially: \nU17 74LS136 - checked\nU20: 74LS12 - checked\nSpeed grade of Buffers (74LS244 or 'F244) - all LS\nU49, U50: both 'LS640 - checked\nU24: 'LS157 - checked\n\n\nAlso: check all the passive components,\nthey are all missing!"
		(exclude_from_sim no)
		(at 230.886 160.02 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "545b0344-34a8-40a8-833c-c8fa7d7e5bc5")
	)
	(text "U44, U45 are mutually exclusive!"
		(exclude_from_sim no)
		(at 338.582 249.174 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "776f50fe-63a7-449d-8cdf-825392315a54")
	)
	(text "Use U44 only for SWTP\nDAT or GIMIX DAT,\notherwise leave empty!"
		(exclude_from_sim no)
		(at 381.508 209.296 0)
		(effects
			(font
